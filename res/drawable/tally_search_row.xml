<!-- A search result or recent search as a Tally key (the prototype's .srow): the surface in a
     hairline edge with 8 dp corners; press and focus feedback stay inside the key. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tally_press">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tally_surface"/>
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_outline_variant"/>
            <corners android:radius="@dimen/tally_radius_s"/>
        </shape>
    </item>
</ripple>
