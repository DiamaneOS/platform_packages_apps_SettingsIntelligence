<resources>
    <!-- The bar at the top of the search panel: Navigate up and More options in the ink, with
         the Tally press, on the page colour. -->
    <style name="ThemeOverlay.Tally.SearchBar" parent="@android:style/ThemeOverlay.Material.ActionBar">
        <item name="android:colorControlNormal">@color/tally_ink</item>
        <item name="android:colorControlHighlight">@color/tally_press</item>
        <item name="android:textColorPrimary">@color/tally_ink</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.Tally.SearchBar.Overflow</item>
    </style>

    <!-- More options as a 48 dp touch target. -->
    <style name="Widget.Tally.SearchBar.Overflow" parent="@android:style/Widget.Material.ActionButton.Overflow">
        <item name="android:minWidth">@dimen/tally_search_bar_key_min_width</item>
    </style>

    <!-- The bar's menu (Clear history) as a Tally menu: the surface with 12 dp corners, the item
         words in the ink. -->
    <style name="ThemeOverlay.Tally.SearchMenu" parent="">
        <item name="android:actionOverflowMenuStyle">@style/Widget.Tally.SearchMenu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Tally.SearchMenu</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Tally.SearchMenu</item>
        <item name="android:colorControlHighlight">@color/tally_press</item>
    </style>

    <style name="Widget.Tally.SearchMenu" parent="@android:style/Widget.Material.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/tally_search_menu</item>
    </style>

    <style name="TextAppearance.Tally.SearchMenu" parent="TextAppearance.Tally.Item">
        <item name="android:textColor">@color/tally_ink</item>
    </style>
</resources>
