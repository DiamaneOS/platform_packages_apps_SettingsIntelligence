<!-- The Tally search panel's words. Both are stock strings, copied with their translations (the
     values-*/tally_strings.xml files) so nothing new needs translating. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The search field's hint: the words of the homepage's search slot (Settings'
         homepage_search), so the panel's field reads as the same slot. [CHAR LIMIT=34] -->
    <string name="tally_search_hint">Search Settings</string>

    <!-- Label of the key that clears the search field: stock SearchView's
         (the framework's searchview_description_clear). [CHAR LIMIT=NONE] -->
    <string name="tally_search_clear">Clear query</string>
</resources>
